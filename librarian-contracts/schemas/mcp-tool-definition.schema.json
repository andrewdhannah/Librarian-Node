{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://librarian.softwareconductor.com/schemas/mcp-tool-definition-v1",
  "title": "MCP Tool Definition Schema",
  "description": "Schema for MCP tool definitions returned by tools/list. Each tool declares its name, description, risk classification, and input schema.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Tool name in snake_case. Used as the 'name' field in tools/call params."
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of what the tool does, when to use it, and any side effects."
    },
    "riskClass": {
      "type": "string",
      "enum": ["R0 Read-Only", "R1 Low-Risk Write", "R3 High-Risk — requires approval token"],
      "description": "Librarian risk classification. R0 = no side effects, R1 = creates/modifies data, R3 = requires explicit approval."
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "object"
        },
        "properties": {
          "type": "object",
          "description": "Map of parameter names to their JSON Schema definitions",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["string", "integer", "number", "boolean", "array", "object"]
              },
              "description": {
                "type": "string"
              },
              "enum": {
                "type": "array",
                "description": "Allowed values for enum parameters"
              },
              "items": {
                "type": "object",
                "description": "Schema for array items"
              }
            },
            "required": ["type"]
          }
        },
        "required": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of parameter names that are required"
        }
      },
      "required": ["type", "properties", "required"]
    }
  },
  "required": ["name", "description", "inputSchema"],
  "examples": [
    {
      "name": "capability_registry_search",
      "description": "Search the capability registry by keyword. Returns metadata only.",
      "riskClass": "R0 Read-Only",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Keyword search against capability names, descriptions, and IDs"
          },
          "type": {
            "type": "string",
            "enum": ["skill", "workflow", "policy", "validator", "template"],
            "description": "Optional filter by capability type"
          },
          "status": {
            "type": "string",
            "enum": ["unreviewed", "reviewed", "qualified", "deprecated", "revoked"],
            "description": "Optional filter by lifecycle status"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum results (default 20, max 100)"
          }
        },
        "required": ["query"]
      }
    }
  ]
}
