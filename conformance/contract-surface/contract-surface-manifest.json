    "enum_strategy": "serde rename_all (snake_case / SCREAMING_SNAKE_CASE)",
    "datetime_format": "RFC 3339 seconds, UTC (e.g. 2026-07-25T02:33:33Z)",
    "receipt_id_format": "{PLATFORM_UPPER}-STARTUP-{YYYYMMDD}-{HHMMSS} UTC (reference-format; variable field)",
    "variable_fields": ["receipt_id", "timestamp"],
    "equivalence_surface": "StartupReceiptFacts — 11 deterministic fields, must match exactly across runs and implementations"
  },
  "types": {
    "StartupReceipt": {
      "kind": "struct",
      "serialized": true,
      "serialized_keys": [
        "receipt_id", "node_id", "platform", "governance_commit", "startup_phase",
        "identity_loaded", "governance_verified", "capabilities_loaded",
        "environment_validated", "checks_passed", "checks_failed", "status", "timestamp"
      ],
      "fields": {
        "receipt_id": { "serde_name": "receipt_id", "type": "String", "constraint": "pattern ^[A-Z0-9-]+$" },
        "node_id": { "serde_name": "node_id", "type": "String", "constraint": "non-empty" },
        "platform": { "serde_name": "platform", "type": "String", "constraint": "windows|linux|macos" },
        "governance_commit": { "serde_name": "governance_commit", "type": "String", "constraint": "40-char lowercase hex SHA" },
        "startup_phase": { "serde_name": "startup_phase", "type": "String", "constraint": "complete|failed (schema outcome; distinct from StartupPhase)" },
        "identity_loaded": { "serde_name": "identity_loaded", "type": "bool" },
        "governance_verified": { "serde_name": "governance_verified", "type": "bool" },
        "capabilities_loaded": { "serde_name": "capabilities_loaded", "type": "bool" },
        "environment_validated": { "serde_name": "environment_validated", "type": "bool" },
        "checks_passed": { "serde_name": "checks_passed", "type": "u32" },
        "checks_failed": { "serde_name": "checks_failed", "type": "u32" },
        "status": { "serde_name": "status", "type": "String", "constraint": "GOVERNED_EXECUTION|STARTUP_FAILED" },
        "timestamp": { "serde_name": "timestamp", "type": "String", "constraint": "RFC 3339 UTC" }
      }
    },
    "StartupReceiptFacts": {
      "kind": "struct",
      "serialized": false,
      "note": "equivalence surface extraction type — not part of the receipt wire format (Serialize derived solely for the drift-guard test)",
      "fields": {
        "node_id": "String", "platform": "String", "governance_commit": "String",
        "startup_phase": "String", "identity_loaded": "bool", "governance_verified": "bool",
        "capabilities_loaded": "bool", "environment_validated": "bool",
        "checks_passed": "u32", "checks_failed": "u32", "status": "String"
      }
    },
    "StartupPhase": {
      "kind": "enum",
      "serialized": true,
      "strategy": "rename_all = snake_case",
      "variants": [
        "identity_loading", "governance_verification", "capability_loading",
        "environment_validation", "receipt_generation", "governed_mode"
      ],
      "note": "protocol step identity (used by StartupCheck.phase); NOT the receipt startup_phase field"
    },
    "StartupStatus": {
      "kind": "enum",
      "serialized": true,
      "strategy": "rename_all = SCREAMING_SNAKE_CASE",
      "variants": ["GOVERNED_EXECUTION", "STARTUP_FAILED"]
    },
    "StartupCheck": {
      "kind": "struct",
      "serialized": true,
      "serialized_keys": ["phase", "passed", "detail"],
      "fields": {
        "phase": { "serde_name": "phase", "type": "StartupPhase" },
        "passed": { "serde_name": "passed", "type": "bool" },
        "detail": { "serde_name": "detail", "type": "String" }
      }
    }
  },
